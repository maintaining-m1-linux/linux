# SPDX-License-Identifier: GPL-2.0-only
#
# Extra options on top of the fairydust config for a daily-driver laptop:
# scheduler/memory tuning for the asymmetric Apple cores, container support
# (passes moby's check-config.sh "Generally Necessary" and network drivers)
# and common filesystems/VPN.
#
# Apply with: scripts/kconfig/merge_config.sh -m .config \
#                 arch/arm64/configs/fairydust-extras.config && make olddefconfig

# Scheduler / memory
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_ZSWAP=y
# sched_ext needs BTF (pahole >= 1.22; with Rust, a pahole with --lang_exclude)
# CONFIG_DEBUG_INFO_REDUCED is not set
CONFIG_DEBUG_INFO_BTF=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_SCHED_CLASS_EXT=y

# Container resource control
CONFIG_CFS_BANDWIDTH=y
CONFIG_BLK_DEV_THROTTLING=y
CONFIG_NET_CLS_CGROUP=m
CONFIG_CGROUP_NET_PRIO=y

# Security: Debian's default container profiles
CONFIG_SECURITY_APPARMOR=y
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,apparmor,bpf"

# netfilter: nftables (iptables-nft) and legacy iptables
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_ARP=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_TABLES_BRIDGE=m
CONFIG_NFT_COMPAT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_CT=m
CONFIG_NFT_REJECT=m
CONFIG_NFT_REJECT_INET=m
CONFIG_NFT_LOG=m
CONFIG_NFT_LIMIT=m
CONFIG_NFT_FIB_INET=m
CONFIG_NFT_FIB_IPV4=m
CONFIG_NFT_FIB_IPV6=m
CONFIG_NFT_TPROXY=m
CONFIG_NFT_SOCKET=m
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_RAW=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_IP_NF_TARGET_REDIRECT=m
CONFIG_IP_NF_TARGET_REJECT=m
CONFIG_IP6_NF_IPTABLES=m
CONFIG_IP6_NF_IPTABLES_LEGACY=m
CONFIG_IP6_NF_FILTER=m
CONFIG_IP6_NF_MANGLE=m
CONFIG_IP6_NF_NAT=m
CONFIG_IP6_NF_RAW=m
CONFIG_IP6_NF_TARGET_MASQUERADE=m
CONFIG_IP6_NF_TARGET_REJECT=m
CONFIG_NETFILTER_XT_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_TARGET_REDIRECT=m
CONFIG_NETFILTER_XT_TARGET_CHECKSUM=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_MATCH_STATE=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m
CONFIG_NETFILTER_XT_MATCH_BPF=m
CONFIG_NETFILTER_XT_MATCH_IPVS=m
CONFIG_NF_NAT_MASQUERADE=y
CONFIG_NF_CONNTRACK_FTP=m
CONFIG_NF_NAT_FTP=m
CONFIG_NF_CONNTRACK_TFTP=m
CONFIG_NF_NAT_TFTP=m
CONFIG_IP_VS_NFCT=y
CONFIG_IP_VS_PROTO_TCP=y
CONFIG_IP_VS_PROTO_UDP=y
CONFIG_IP_VS_RR=m

# Container network drivers (overlay, ipvlan, macvlan, encrypted overlay)
CONFIG_VXLAN=m
CONFIG_IPVLAN=m
CONFIG_MACVLAN=m
CONFIG_DUMMY=m
CONFIG_XFRM=y
CONFIG_XFRM_USER=y
CONFIG_INET_ESP=m
CONFIG_CRYPTO_SEQIV=m

# VPN, storage, filesystems, input
CONFIG_WIREGUARD=m
CONFIG_DM_CRYPT=m
CONFIG_USB_UAS=m
CONFIG_EXFAT_FS=m
CONFIG_NTFS3_FS=m
CONFIG_HIDRAW=y
CONFIG_HID_LOGITECH_DJ=m
CONFIG_HID_LOGITECH_HIDPP=m

# Apple AVD hardware video decoder: built-in (probes before the camera ISP
# module, so it owns /dev/media0+/dev/video0 as the Firefox sandbox patch
# expects) with the open-source firmware embedded, because the built-in
# driver probes before the rootfs (and /lib/firmware) is mounted.
# Build the firmware once with fox-builder's setup-avd-fw first.
CONFIG_VIDEO_APPLE_AVD=y
CONFIG_EXTRA_FIRMWARE_DIR="/lib/firmware"
CONFIG_EXTRA_FIRMWARE="apple/avd-fw-v2-t0.bin"
